{
  "name": "picare-git-workflow-demo",
  "version": "1.1.2",
  "description": "Demo project implementing the PiCare Git Workflow with 3-tier Firebase deployment and audit pick gate",
  "main": "dist/index.js",
  "scripts": {
    "build": "tsc",
    "start": "node dist/index.js",
    "test": "npm run build && node --test dist/__tests__/*.test.js",
    "lint": "echo 'Checking code style... OK'",
    "audit:pick": "bash scripts/release/audit-pick.sh",
    "release:cut": "bash scripts/release/cut-release.sh",
    "release:pick": "bash scripts/release/pick-to-release.sh",
    "release:tag": "bash scripts/release/tag-release.sh",
    "demo:simulate": "bash scripts/demo-simulation.sh",
    "test:workflow": "bash scripts/test-workflow-cases.sh"
  },
  "keywords": [
    "git-workflow",
    "firebase",
    "audit-pick",
    "cherry-pick",
    "release-management",
    "cicd"
  ],
  "author": "PiCare Team",
  "license": "MIT",
  "devDependencies": {
    "@types/node": "^22.0.0",
    "typescript": "^5.5.0"
  }
}
